{
  "name": "signora-pdf",
  "version": "0.1.0-alpha.0",
  "description": "Modular, extensible and themeable Angular SDK for viewing, visually signing and digitally signing PDF documents.",
  "license": "MIT",
  "keywords": [
    "angular",
    "pdf",
    "signature",
    "esign",
    "pdf.js",
    "pdf-lib",
    "pades"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscarandrespabonestrella/signora-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/oscarandrespabonestrella/signora-pdf/issues"
  },
  "homepage": "https://oscarandrespabonestrella.github.io/signora-pdf/",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": "^22.3.0",
    "@angular/core": "^22.3.0",
    "asn1js": "^3.0.0 || ^4.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.0.0 || ^6.0.0",
    "pkijs": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "asn1js": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "pkijs": {
      "optional": true
    }
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/public-api.ts",
    "./pdfjs": "./pdfjs/src/public-api.ts",
    "./pdf-lib": "./pdf-lib/src/public-api.ts",
    "./ui": "./ui/src/public-api.ts",
    "./http": "./http/src/public-api.ts",
    "./validation": "./validation/src/public-api.ts"
  }
}
