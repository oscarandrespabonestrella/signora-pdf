{
  "$schema": "https://typedoc.org/schema.json",
  "name": "signora-pdf API",
  "tsconfig": "tsconfig.docs.json",
  "entryPoints": [
    "projects/signora-pdf/src/public-api.ts",
    "projects/signora-pdf/pdfjs/src/public-api.ts",
    "projects/signora-pdf/pdf-lib/src/public-api.ts",
    "projects/signora-pdf/ui/src/public-api.ts",
    "projects/signora-pdf/http/src/public-api.ts"
  ],
  "out": "docs/api",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": false,
  "navigation": { "includeCategories": false, "includeGroups": true },
  "sort": ["kind", "alphabetical"],
  "validation": { "notExported": true, "invalidLink": true, "notDocumented": false },
  "treatWarningsAsErrors": false
}
