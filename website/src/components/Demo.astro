---
// Live demo: embeds the playground (built under /demo/) in an iframe.
interface Props {
  route?: string;
  title: string;
  height?: number;
}
const { route = '', title, height = 720 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/demo/?embed=1#/${route}`;
---

<figure class="demo">
  <iframe src={src} title={title} loading="lazy" style={`height:${height}px`}></iframe>
  <figcaption>
    <a href={`${base}/demo/#/${route}`} target="_blank" rel="noopener">Open full screen ↗</a>
  </figcaption>
</figure>

<style>
  .demo { margin: 1.5rem 0; }
  iframe {
    width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: #fff;
  }
  figcaption { font-size: var(--sl-text-sm); text-align: right; margin-top: 0.25rem; }
</style>
